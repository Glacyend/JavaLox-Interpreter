var startTime = clock();

class Person {
    init(name, age) {
        this.name = name;
        this.age = age;
    }

    greet() {
        print "Hello, I'm " + this.name + "!";
    }

    printInfo() {
        print "Name: ";
        print this.name;
        print "Age: ";
        print this.age;
    }
}

var person = Person("Glacyend", 16);
person.greet();
person.printInfo();

var endTime = clock();

print "Program Execution Time (ms)";
print (endTime - startTime) * 1000;
